# Copy to .env.local for local development. Real environment variables win.
APP_ENV=development
LOG_LEVEL=debug

SERVER_PORT=8080
SERVER_READ_TIMEOUT=15
SERVER_WRITE_TIMEOUT=30
SERVER_IDLE_TIMEOUT=60
SERVER_SHUTDOWN_TIMEOUT=15
SERVER_CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_HOST=localhost
DB_PORT=5433
DB_USER=gpu
DB_PASSWORD=gpu
DB_NAME=gpu
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=300
DB_CONN_MAX_IDLE_TIME=60

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
